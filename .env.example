# Single .env for the whole monorepo. Copy to .env and fill in.
#   cp .env.example .env
# Read by docker compose, by the Go API, and (VITE_* only) by the frontend.

# ─── HTTP ────────────────────────────────────────────────────────────────────
API_PORT=8431
API_BASE_URL=http://localhost:8431
WEB_PORT=5391
CORS_ALLOWED_ORIGINS=http://localhost:5391

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=discovery
POSTGRES_PASSWORD=discovery
POSTGRES_DB=discovery
POSTGRES_PORT=54329
DATABASE_URL=postgres://discovery:discovery@localhost:54329/discovery?sslmode=disable

# ─── Object storage (rustfs, S3-compatible) ──────────────────────────────────
S3_ENDPOINT=http://localhost:9311
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY=discovery
S3_SECRET_KEY=discovery
S3_USE_PATH_STYLE=true

# Deletes the original file from object storage once it has been parsed and
# summarised into the Company Context. True in dev to keep the volume small.
# MUST be false in production — the raw file is the only way to re-parse.
STORAGE_DELETE_AFTER_INGEST=true

# ─── LLM provider (any OpenAI-compatible API) ────────────────────────────────
# Works with OpenAI, OpenRouter, Groq, Together, vLLM, Ollama, LM Studio.
# The model MUST support tool calling — the whole orchestrator depends on it.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
# Used for the per-Document summariser. Cheaper model is fine — set equal to
# LLM_MODEL if you would rather not think about it.
LLM_SUMMARY_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=120
# Cap on concurrent in-flight LLM calls. Keep at or below your provider's rate
# limit; it is what the Provider's semaphore is sized from.
LLM_MAX_CONCURRENT=8

# ─── Worker (River) ──────────────────────────────────────────────────────────
# Set false to run this process as HTTP-only and leave Nodes to another one.
WORKER_ENABLED=true
# Parallelism of the Discovery Run fan-out: how many sibling Nodes run at once.
RIVER_MAX_WORKERS=8

# ─── Discovery Run budgets ───────────────────────────────────────────────────
# Bug brakes, not product settings. opportunity_count comes from the frontend.
MAX_DEPTH=3
MAX_NODES_PER_RUN=40
MAX_UPLOAD_BYTES=10485760

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8431
